<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="MQVOX" android:textStyle="bold" android:textSize="30sp" android:gravity="center" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/privacy_claim" android:gravity="center" android:paddingBottom="18dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <Spinner android:id="@+id/sourceLanguage" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" />
            <Button android:id="@+id/swapButton" android:layout_width="56dp" android:layout_height="56dp" android:text="⇄" android:contentDescription="Swap languages" />
            <Spinner android:id="@+id/targetLanguage" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" />
        </LinearLayout>

        <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Ready" android:textStyle="bold" android:gravity="center" android:padding="18dp" />

        <Button android:id="@+id/micButton" android:layout_width="140dp" android:layout_height="84dp"
            android:layout_gravity="center" android:text="🎙  Speak" android:textSize="20sp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Recognized Speech" android:textStyle="bold" android:paddingTop="22dp" />
        <TextView android:id="@+id/sourceText" android:layout_width="match_parent" android:layout_height="100dp"
            android:textIsSelectable="true" android:padding="12dp" android:background="#11000000" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Translation" android:textStyle="bold" android:paddingTop="18dp" />
        <TextView android:id="@+id/translationText" android:layout_width="match_parent" android:layout_height="130dp"
            android:textIsSelectable="true" android:textSize="22sp" android:padding="12dp" android:background="#19000000" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:paddingTop="12dp">
            <Button android:id="@+id/replayButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Replay" />
            <Button android:id="@+id/copyButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Copy" />
            <Button android:id="@+id/clearButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Clear" />
        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/autoSpeak" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Auto Speak" android:checked="true" android:layout_gravity="center_horizontal" />
    </LinearLayout>
</ScrollView>
